# Server-only COPOMEX API token for Mexican postal-code lookups.
COPOMEX_TOKEN=

# Server-only Mapbox token used by the geocoding API route.
MAPBOX_ACCESS_TOKEN=

# Public Mapbox token used by the interactive map picker in the browser.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Platform Clip account used to charge tenants' monthly subscription (server-only).
CLIP_API_KEY=
CLIP_API_SECRET=

# Public HTTPS domain used for Clip return/webhook URLs (/business/billing, /api/billing/clip/webhook).
PAYMENT_CALLBACK_BASE_URL=

# Monthly subscription price charged to each tenant (default 499).
SUBSCRIPTION_MONTHLY_PRICE=499

# Timezone used to bucket sales by day/hour (default America/Mexico_City).
BUSINESS_TIMEZONE=America/Mexico_City
