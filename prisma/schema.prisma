generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  trial
  pending_payment
  active
  suspended
  cancelled
}

enum UserRole {
  super_admin
  restaurant_admin
  customer
}

model Tenant {
  id String @id @default(uuid())

  businessName String

  prefix String @unique

  referralCode String @unique

  status TenantStatus @default(trial)

  trialEndsAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  users User[]

  restaurants Restaurant[]

  referralCodes ReferralCode[]

  @@map("tenants")
}

model User {
  id String @id @default(uuid())

  email String @unique

  passwordHash String

  role UserRole

  accounts Account[]

  sessions Session[]

  tenantId String?

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@map("users")
}

model Restaurant {
  id String @id @default(uuid())

  tenantId String

  tenant Tenant @relation(fields: [tenantId], references: [id])

  name String

  active Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@map("restaurants")
}

model SaaSSettings {
  id String @id @default(uuid())

  trialEnabled Boolean @default(true)

  trialDays Int @default(15)

  referralEnabled Boolean @default(true)

  referralRewardPercent Float @default(5)

  referredRewardPercent Float @default(15)

  maxMonthlyReferralDiscount Float @default(50)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@map("saas_settings")
}

model SubscriptionPlan {
  id String @id @default(uuid())

  name String

  description String?

  price Float

  active Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@map("subscription_plans")
}

enum PromotionType {
  percentage
  fixed_amount
  free_month
  free_setup
}

model SaaSPromotion {

  id String @id @default(uuid())

  name String

  code String @unique

  type PromotionType

  value Float

  active Boolean @default(true)

  startsAt DateTime

  endsAt DateTime

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@map("saas_promotions")
}

model ReferralCode {
  id String @id @default(uuid())

  tenantId String

  tenant Tenant @relation(fields: [tenantId], references: [id])

  code String @unique

  active Boolean @default(true)

  createdAt DateTime @default(now())

  @@map("referral_codes")
}

model TenantReferral {
  id String @id @default(uuid())

  referrerTenantId String

  referredTenantId String

  status String

  createdAt DateTime @default(now())

  qualifiedAt DateTime?

  @@map("tenant_referrals")
}

model Account {
  id                String @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String

  refresh_token String?
  access_token  String?
  expires_at    Int?
  token_type    String?
  scope         String?
  id_token      String?
  session_state String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String @id @default(cuid())
  sessionToken String @unique

  userId String

  expires DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
